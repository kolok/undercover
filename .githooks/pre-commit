#!/usr/bin/env sh
# Formate lib/ et test/ avec dart format, puis re-stage les fichiers concernés.
set -e
cd "$(git rev-parse --show-toplevel)"

if ! command -v dart >/dev/null 2>&1; then
  echo "pre-commit: « dart » introuvable dans le PATH (installez Flutter / le SDK Dart)." >&2
  exit 1
fi

dart format lib test

# Ne re-stager que les chemins déjà dans l’index (y compris les nouveaux fichiers staged).
STAGED=$(git diff --cached --name-only --diff-filter=ACM -- lib test || true)
if [ -n "$STAGED" ]; then
  # shellcheck disable=SC2086
  git add -- $STAGED
fi
